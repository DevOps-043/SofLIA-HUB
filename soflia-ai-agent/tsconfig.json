{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "strict": true, "skipLibCheck": true, "noEmit": true,
    "jsx": "react-jsx", "allowImportingTsExtensions": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "types": ["vite/client", "node"]
  },
  "include": ["integration", "demo"]
}
