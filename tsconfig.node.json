  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.mts",
    "vite.presentation.config.mts",
    "vite.audiovisual.config.mts",
    "config/vite/**/*.mts",
    "vite.zoom.config.mts"
  ]
}
