{
  "name": "soflia-hub-desktop",
  "private": true,
  "version": "0.1.17",
  "description": "SofLIA Hub Desktop Client",
  "author": "Pulse Hub",
  "scripts": {
    "dev": "vite",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-clean.ps1",
    "dev:fresh": "npm run dev:clean && npm run dev",
    "build": "tsc && vite build && node scripts/generate-bitmaps.js && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "autodev": "npx tsx scripts/autodev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:main": "vitest run --project main",
    "test:renderer": "vitest run --project renderer"
  },
  "dependencies": {
    "@azure/msal-node": "^5.0.4",
    "@google/generative-ai": "^0.24.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@supabase/supabase-js": "^2.95.3",
    "@types/archiver": "^6.0.2",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "active-win": "^8.2.1",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.8.0",
    "cron": "^4.4.0",
    "docx": "^8.5.0",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.18.2",
    "googleapis": "^171.4.0",
    "mammoth": "^1.11.0",
    "node-cron": "3.0.3",
    "nodemailer": "^6.9.13",
    "pino": "^10.3.1",
    "playwright-core": "^1.58.2",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "systeminformation": "5.21.22",
    "tesseract.js": "^5.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cron": "^2.0.1",
    "@types/node": "^25.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.24",
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "install": "0.13.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "npm": "11.11.0",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.0"
  },
  "main": "dist-electron/main.js"
}
