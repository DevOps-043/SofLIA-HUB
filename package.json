{
  "name": "soflia-hub-desktop",
  "private": true,
  "version": "0.15.0",
  "description": "Pulse Hub Desktop Client",
  "author": {
    "name": "Pulse Hub",
    "email": "devops@soflia.ai"
  },
  "scripts": {
    "dev": "vite --config vite.config.mts",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-clean.ps1",
    "dev:fresh": "npm run dev:clean && npm run dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build:app": "npm run typecheck && vite build --config vite.config.mts",
    "build": "npm run build:app && node scripts/generate-bitmaps.js && node scripts/setup-python-runtime.js && electron-builder",
    "build:win": "npm run build:app && node scripts/generate-bitmaps.js && node scripts/setup-python-runtime.js && electron-builder --win",
    "build:mac": "npm run build:app && node scripts/generate-bitmaps.js && node scripts/setup-python-runtime.js && electron-builder --mac",
    "build:linux": "npm run build:app && node scripts/generate-bitmaps.js && node scripts/setup-python-runtime.js && electron-builder --linux AppImage deb --x64",
    "postinstall": "install-electron",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:changed": "node scripts/quality/lint-changed.mjs",
    "adapters:sync": "node scripts/ai/sync-agent-adapters.mjs",
    "adapters:check": "node scripts/ai/sync-agent-adapters.mjs --check",
    "audit:supply-chain": "node scripts/quality/check-supply-chain.mjs",
    "harness:validate": "node scripts/quality/validate-harness.mjs",
    "docs:check": "node scripts/quality/check-doc-links.mjs",
    "docs:system:check": "node scripts/quality/validate-system-docs.mjs",
    "openspec:validate": "openspec validate --all --strict --no-interactive",
    "verify:pr": "node scripts/quality/run-gate.mjs",
    "verify:release": "node scripts/quality/run-gate.mjs --release",
    "preview": "vite preview",
    "desktop-agent:install-omniparser": "node scripts/install-omniparser-model.js",
    "python:setup": "node scripts/setup-python-runtime.js",
    "python:install-vosk-model": "node scripts/install-vosk-model.js",
    "test": "vitest run",
    "test:fast": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:main": "vitest run --project main",
    "test:renderer": "vitest run --project renderer"
  },
  "dependencies": {
    "@azure/msal-node": "^5.0.4",
    "@google/genai": "^2.15.0",
    "@google/generative-ai": "^0.24.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/archiver": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "active-win": "^8.2.1",
    "archiver": "^8.0.0",
    "cron": "^4.4.0",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.0.0",
    "googleapis": "^174.0.1",
    "mammoth": "^1.11.0",
    "meyda": "^5.6.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.4",
    "onnxruntime-node": "^1.27.0",
    "openai": "^7.3.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.58.2",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "systeminformation": "^5.31.6",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.6.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cron": "^2.0.1",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.24",
    "electron": "^43.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "install": "0.13.0",
    "jsdom": "^30.0.1",
    "msw": "^2.12.14",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "protobufjs": "^7.5.6",
    "tar": "^7.5.20",
    "node-abi": "^4.33.0"
  },
  "main": "dist-electron/main.js"
}
