<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse Hub — Instalación" Width="980" Height="640" WindowStyle="None"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#071520"
        FontFamily="Segoe UI" Foreground="#EDF5F6" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#C4D5DB"/>
      <Setter Property="Background" Value="#132936"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2B424D"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Frame" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Viewbox Stretch="Uniform">
    <Border Width="980" Height="640" BorderBrush="#2B424D" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
      <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#071520" Offset="0"/><GradientStop Color="#0A2540" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,-40,0" IsHitTestVisible="False">
          <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#3500D4B3" Offset="0"/><GradientStop Color="#0000D4B3" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Grid Margin="36,0">
          <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="350"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid x:Name="TitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="44" Height="40" Background="#EAF6F5" CornerRadius="10" Margin="0,0,12,0"><Image x:Name="BrandLogo" Margin="5" Stretch="Uniform" AutomationProperties.Name="Logo original de SofLIA"/></Border>
              <TextBlock Text="Pulse Hub" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="/  SOFLIA" FontSize="11" Foreground="#8AABBA" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="Motion" Content="Pausar animación" FontSize="11" Background="Transparent" BorderThickness="0" Margin="0,0,10,0"/>
              <Button x:Name="Minimize" Content="−" FontSize="20" Width="38" Padding="0" Height="34" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Minimizar"/>
              <Button x:Name="Close" Content="×" FontSize="22" Width="38" Padding="0" Height="34" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Cerrar"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="450"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="8,35,0,0">
              <TextBlock x:Name="Eyebrow" Text="TU SIGUIENTE GRAN IDEA EMPIEZA AQUÍ" FontSize="10" FontWeight="SemiBold" Foreground="#00D4B3"/>
              <TextBlock x:Name="Headline" Text="Más espacio&#10;para lo que&#10;imaginas." FontSize="53" FontWeight="Light" LineHeight="57" Margin="0,18,0,16"/>
              <TextBlock x:Name="Description" Text="Navega, crea y trabaja con SofLIA.&#10;Todo conectado. Todo en tu espacio." FontSize="15" Foreground="#ACC3CE" LineHeight="23" TextWrapping="Wrap" Width="394" HorizontalAlignment="Left"/>
            </StackPanel>
            <Grid x:Name="OrbHost" Grid.Column="1" Margin="0,0,-12,0"/>
          </Grid>
          <Grid Grid.Row="2" Margin="8,10,8,0">
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="01   NAVEGADOR" FontSize="10" Foreground="#B1C7D1" Margin="0,0,28,0"/>
              <TextBlock Text="02   AGENTE IA" FontSize="10" Foreground="#B1C7D1" Margin="0,0,28,0"/>
              <TextBlock Text="03   PYTHON PRIVADO" FontSize="10" Foreground="#B1C7D1"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#B20A1B28" BorderBrush="#29424F" BorderThickness="1" CornerRadius="14" Padding="20,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                  <TextBlock x:Name="Status" Text="Un nuevo lugar para tus ideas." FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  <TextBlock x:Name="Detail" Text="Python incluido. Sin cambiar el Python de tu equipo." FontSize="11" Foreground="#A9C1CC" Margin="0,7,0,0" TextWrapping="Wrap"/>
                  <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="3" Margin="0,12,0,0" Foreground="#00D4B3" Background="#244150" BorderThickness="0" Minimum="0" Maximum="100" AutomationProperties.Name="Progreso de preparación"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="Primary" Content="Instalar Pulse Hub   ↗" FontSize="14" FontWeight="SemiBold" Foreground="#06292B" Background="#00D4B3" BorderBrush="#00D4B3" Padding="16,13"/>
                  <Button x:Name="Secondary" Content="Opciones de instalación" Background="Transparent" BorderThickness="0" FontSize="10" Padding="8,7" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <DockPanel Grid.Row="2" VerticalAlignment="Center">
              <TextBlock x:Name="Version" Text="WINDOWS x64" FontSize="9" Foreground="#94AEBB" DockPanel.Dock="Left"/>
              <TextBlock x:Name="Footer" Text="Sin descargas adicionales para instalar · Modelos de voz bajo demanda" FontSize="9" Foreground="#94AEBB" HorizontalAlignment="Right"/>
            </DockPanel>
          </Grid>
        </Grid>
        <Border x:Name="OptionsPanel" Visibility="Collapsed" Background="#F5091926" Padding="44" CornerRadius="16">
          <StackPanel VerticalAlignment="Center" Width="740">
            <TextBlock Text="Tu espacio. Tus opciones." FontSize="36" FontWeight="Light"/>
            <TextBlock Text="Instalación para tu usuario de Windows. Los datos personales se conservan al actualizar." TextWrapping="Wrap" Foreground="#ACC3CE" Margin="0,14,0,26"/>
            <TextBlock Text="Carpeta de instalación" Margin="0,0,0,10"/>
            <TextBox x:Name="Destination" FontSize="14" Padding="12" Background="#132936" Foreground="#EDF5F6" BorderBrush="#52727E" AutomationProperties.Name="Carpeta de instalación"/>
            <TextBlock Text="Usa una carpeta local dedicada a Pulse Hub. No elijas la raíz del disco ni una carpeta con otros archivos. Cierra Pulse Hub antes de instalar." Foreground="#ACC3CE" TextWrapping="Wrap" Margin="0,12,0,24"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="OptionsDone" Content="Guardar y volver" HorizontalAlignment="Left" Background="#00D4B3" Foreground="#06292B"/>
              <Button x:Name="OptionsCancel" Content="Cancelar" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="OptionsError" Foreground="#FDC78B" TextWrapping="Wrap" Margin="0,16,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Viewbox>
</Window>
