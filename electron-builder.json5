// @see - https://www.electron.build/configuration/configuration
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.pulsehub.sofliahub",
  npmRebuild: false,
  asar: true,
  asarUnpack: [
    "**/node_modules/onnxruntime-node/**",
  ],
  productName: "Pulse Hub",
  publish: [
    {
      provider: "github",
      owner: "DevOps-043",
      repo: "PulseHub-SofLIA-releases",
      releaseType: "release",
    },
  ],
  directories: {
    output: "release/${version}",
    buildResources: "build",
  },
  afterPack: "scripts/verify-packaged-python.cjs",
  files: [
    "dist",
    "dist-electron",
    "!node_modules/**/*.d.ts",
    "!node_modules/**/*.d.ts.map",
  ],
  // Python y el sidecar se distribuyen con la aplicacion en las tres plataformas.
  extraResources: [
    {
      from: "python-runtime",
      to: "python",
      filter: ["**/*", "!.setup-lock.json"],
    },
    {
      from: "python/sidecar",
      to: "python-sidecar",
      filter: ["**/*", "!**/__pycache__/**", "!**/*.pyc"],
    },
    {
      // Sidecar de herramientas (documentos + privacidad). Proceso separado del
      // de voz: un fallo leyendo un PDF no debe tumbar la escucha pasiva.
      from: "python/tools_sidecar",
      to: "python-tools",
      filter: ["**/*", "!tests/**", "!**/__pycache__/**", "!**/*.pyc"],
    },
    {
      // Contexto operativo de reuniones. Se distribuye separado del código
      // para impedir que las instrucciones de desarrollo lleguen al runtime.
      from: "resources/context-packs/meetings/v1",
      to: "context-packs/meetings/v1",
      filter: ["**/*"],
    },
  ],
  // Icono.png es el logotipo horizontal que usa la UI; los empaquetadores
  // exigen iconos cuadrados, por eso apuntan al master generado por
  // `node scripts/generate-app-icons.js`.
  mac: {
    target: ["dmg"],
    icon: "public/assets/icon.png",
    artifactName: "Pulse-Hub-Mac-${version}-Installer.${ext}",
    // El runtime endurecido bloquea camara y microfono si no se declaran las
    // entitlements, y macOS deniega el acceso (o cierra el proceso) si el
    // Info.plist no explica para que se piden.
    entitlements: "build/entitlements.mac.plist",
    entitlementsInherit: "build/entitlements.mac.plist",
    extendInfo: {
      NSCameraUsageDescription: "Pulse Hub usa la camara cuando una pagina abierta en el navegador integrado la solicita y tu apruebas el permiso.",
      NSMicrophoneUsageDescription: "Pulse Hub usa el microfono para dictado, reuniones y para las paginas del navegador integrado a las que apruebas el permiso.",
    },
  },
  dmg: {
    background: "build/installer/dmg-background.png",
    iconSize: 104,
    window: { width: 660, height: 400 },
    contents: [
      { x: 180, y: 214, type: "file" },
      { x: 480, y: 214, type: "link", path: "/Applications" },
    ],
  },
  win: {
    icon: "public/assets/icono.ico",
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "Pulse-Hub-Windows-${version}-Setup.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowElevation: true,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    installerIcon: "public/assets/icono.ico",
    uninstallerIcon: "public/assets/icono.ico",
    installerHeader: "build/installer/installerHeader.bmp",
    installerSidebar: "build/installer/installerSidebar.bmp",
    uninstallerSidebar: "build/installer/uninstallerSidebar.bmp",
    include: "build/installer.nsh",
    unicode: true,
    runAfterFinish: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "Pulse Hub",
    uninstallDisplayName: "Pulse Hub",
  },
  linux: {
    icon: "public/assets/icon.png",
    category: "Office",
    synopsis: "AI-powered business operations platform",
    description: "Pulse Hub Desktop Client",
    executableName: "soflia-hub",
    target: [
      {
        target: "AppImage",
        arch: ["x64"],
      },
      {
        target: "deb",
        arch: ["x64"],
      },
    ],
    // ${arch} se renderiza como "x86_64" para AppImage x64, pero el workflow y
    // el smoke test esperan el sufijo literal "x64" (igual que Windows/Mac fijan
    // Setup/Installer). Fijarlo evita el desajuste de nombre en release.yml.
    artifactName: "Pulse-Hub-Linux-${version}-x64.${ext}",
    desktop: {
      entry: {
        Name: "Pulse Hub",
        Comment: "AI-powered business operations platform",
        Categories: "Office;Productivity;",
        Keywords: "productivity;business;ai;whatsapp;google;",
        StartupWMClass: "soflia-hub",
      },
    },
  },
  deb: {
    depends: ["libportaudio2"],
  },
}
