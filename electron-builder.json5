// @see - https://www.electron.build/configuration/configuration
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.pulsehub.sofliahub",
  npmRebuild: false,
  asar: true,
  asarUnpack: [
    "**/node_modules/onnxruntime-node/**",
  ],
  productName: "SofLIA Hub",
  publish: [
    {
      provider: "github",
      owner: "DevOps-043",
      repo: "PulseHub-SofLIA-releases",
      releaseType: "release",
    },
  ],
  directories: {
    output: "release/${version}",
    buildResources: "build",
  },
  files: [
    "dist",
    "dist-electron",
    "!node_modules/**/*.d.ts",
    "!node_modules/**/*.d.ts.map",
  ],
  mac: {
    target: ["dmg"],
    artifactName: "SofLIA-Hub-Mac-${version}-Installer.${ext}",
  },
  win: {
    icon: "public/assets/icono.ico",
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "SofLIA-Hub-Windows-${version}-Setup.${ext}",
  },
  nsis: {
    oneClick: true,
    perMachine: false,
    deleteAppDataOnUninstall: false,
    installerIcon: "public/assets/icono.ico",
    uninstallerIcon: "public/assets/icono.ico",
    include: "build/installer.nsh",
    unicode: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "SofLIA Hub",
    uninstallDisplayName: "SofLIA Hub",
  },
  linux: {
    icon: "public/assets/Icono.png",
    category: "Office",
    synopsis: "AI-powered business operations platform",
    description: "SofLIA Hub Desktop Client",
    executableName: "soflia-hub",
    target: [
      {
        target: "AppImage",
        arch: ["x64"],
      },
    ],
    // ${arch} se renderiza como "x86_64" para AppImage x64, pero el workflow y
    // el smoke test esperan el sufijo literal "x64" (igual que Windows/Mac fijan
    // Setup/Installer). Fijarlo evita el desajuste de nombre en release.yml.
    artifactName: "SofLIA-Hub-Linux-${version}-x64.${ext}",
    desktop: {
      entry: {
        Name: "SofLIA Hub",
        Comment: "AI-powered business operations platform",
        Categories: "Office;Productivity;",
        Keywords: "productivity;business;ai;whatsapp;google;",
        StartupWMClass: "soflia-hub",
      },
    },
  },
}
