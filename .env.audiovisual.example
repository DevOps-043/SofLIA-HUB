# Copiar a .env.audiovisual.local o ejecutar npm run audiovisual:setup.
# Variables públicas de capacidad; no son claves de API.
VITE_SKILL_AUDIOVISUAL_ENABLED=true
# Rutas absolutas de ejecutables locales verificados, exclusivas de main.
# Vacías: se usa media-runtime/ffmpeg y media-runtime/ffprobe junto al proyecto.
SOFLIA_FFMPEG_PATH=
SOFLIA_FFPROBE_PATH=
